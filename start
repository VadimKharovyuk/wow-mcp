# ===== Памятка запуска (это заметка, не скрипт; подробнее: docs/ЗАПУСК.md) =====

# --- 1. Всё сразу: собрать, запустить Chrome с игрой, открыть OpenCode ---
~/Downloads/wow-mcp/deploy.sh


# --- 2. Только Chrome с игрой (если deploy.sh не нужен) ---
/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome \
  --remote-debugging-port=9222 \
  --user-data-dir="$HOME/chrome-wow" \
  --disable-background-timer-throttling \
  --disable-renderer-backgrounding \
  --disable-backgrounding-occluded-windows


# --- 3. Дашборд статистики (http://localhost:8085) ---
java -jar dashboard/target/wow-dashboard.jar
# Остановка: Ctrl+C, либо
kill $(lsof -nP -t -iTCP:8085 -sTCP:LISTEN)
